enum PoolMemberStatus {
  PENDING
  PAID
  CANCELLED
}

model PoolMember {
  id            String           @id @default(uuid()) @db.Uuid
  poolId        String           @map("pool_id") @db.Uuid
  rideRequestId String           @unique @map("ride_request_id") @db.Uuid
  passengerId   String           @map("passenger_id") @db.Uuid
  seatNumber    Int              @map("seat_number")
  fare          Int
  status        PoolMemberStatus @default(PENDING)
  joinedAt      DateTime         @default(now()) @map("joined_at")
  leftAt        DateTime?        @map("left_at")

  pool        Pool        @relation(fields: [poolId], references: [id])
  rideRequest RideRequest @relation(fields: [rideRequestId], references: [id])
  passenger   User        @relation("PassengerPoolMembers", fields: [passengerId], references: [id])
  payments    Payment[]

  @@index([poolId])
  @@index([rideRequestId])
  @@index([passengerId])
  @@map("pool_members")
}
